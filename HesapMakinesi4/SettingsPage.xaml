<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesi4.SettingsPage"
             Title="Ayarlar">

    <!--bütün ayarları alt alta sıralı dizdik-->
    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Start">

        <!-- tema seçimi alanı -->
        <Label Text="Tema Seçimi" Style="{StaticResource SettingsHeaderStyle}" />
        <Picker x:Name="ThemePicker" SelectedIndexChanged="temaDegisimYapildi" Title="Tema Seçiniz">
            <Picker.Items>
                <x:String>Açık Tema</x:String>
                <x:String>Koyu Tema</x:String>
                <x:String>Sistem Teması</x:String>
            </Picker.Items>
        </Picker>

        <BoxView HeightRequest="1" Color="Gray" Margin="0,15" />

        <!-- uygulama boyutu seçilen alan -->
        <Label Text="Uygulama Boyutu" Style="{StaticResource SettingsHeaderStyle}" />
        <Label Text="Hassas ölçeklendirme (0.85x - 1.15x)" Style="{StaticResource SettingsSubHeaderStyle}" Margin="0,-15,0,5"/>

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,10,0,0">
            <Button Text="-" FontSize="24" FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" 
                Clicked="boyutKucultTiklandi" Style="{StaticResource OperationButtonStyle}" Padding="0"/>

            <Label x:Name="SizeLabel" Text="1,00x" FontAttributes="Bold" VerticalOptions="Center" 
               Style="{StaticResource SettingsHeaderStyle}" FontSize="20" WidthRequest="70" HorizontalTextAlignment="Center"/>

            <Button Text="+" FontSize="24" FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" 
                Clicked="boyutBuyutTiklandi" Style="{StaticResource OperationButtonStyle}" Padding="0"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>